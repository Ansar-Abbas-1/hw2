<?xml version="1.0"?>
<sdf version="1.9">

  <model name="simulated_camera">

    <static>true</static>

    <link name="camera_link">

      <sensor name="camera" type="camera">

        <always_on>true</always_on>
        <update_rate>30</update_rate>

        <topic>simulated_camera</topic>

        <camera name="camera">
          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>

        </camera>

      </sensor>

    </link>

  </model>

</sdf>
