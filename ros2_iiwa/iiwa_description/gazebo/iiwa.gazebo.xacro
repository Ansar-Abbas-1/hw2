<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="iiwa_gazebo" params="runtime_config_package controllers_file namespace prefix">

    <!-- ros_control plugin -->
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <xacro:if value="${namespace != '/'}">
          <ros>
            <namespace>/${namespace[:-1]}</namespace>
          </ros>
          <robot_param_node>/${namespace}robot_state_publisher</robot_param_node>
        </xacro:if>
        <parameters>$(find ${runtime_config_package})/config/${controllers_file}</parameters>
      </plugin>
    </gazebo>

    <!-- Link 7 appearance -->
    <gazebo reference="${prefix}link_7">
      <material>Gazebo/Gray</material>
    </gazebo>

    <!-- Eye-in-hand camera sensor attached to camera_link -->
    <gazebo reference="${prefix}camera_link">

      <sensor name="eye_in_hand_camera" type="camera">
        <pose>0 0 0 0 -0.922 -0.468</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>

        <topic>eye_in_hand_camera</topic>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>

        </camera>

      </sensor>

    </gazebo>

  </xacro:macro>
</robot>
